From: millia ampora <198710911+dappermint@users.noreply.github.com>
Date: Wed, 26 Aug 2026 06:55:43 +0400
Subject: [PATCH 1/2] Windows/UnixLib: implement the unix helpers for macOS

macOS has no prctl, so the four handlers built on it need their own
paths. hardware TSO and kernel unaligned atomic control have no
equivalent and report unsupported, which leaves FEX on its software
handling for both. naming an anonymous mapping is a linux-only
convenience and becomes a noop.

madvise exists but the advice values arriving here are the linux ones,
and MADV_FREE differs (8 on linux, 5 here), so a raw pass-through would
free the wrong way. the values FEX uses are mapped and anything
unrecognised is dropped, since madvise is advisory.

the stats SHM is stubbed. macOS only lets a POSIX shm segment be
ftruncated once, so the grow path cannot work as written; the feature is
telemetry and nothing else depends on it.

[ported onto FEX-2609: MapFile is kept unchanged, since macOS accepts
MAP_SHARED | MAP_NORESERVE for a read-only file mapping]

Signed-off-by: Nilton Perim Neto <niltonperimneto@gmail.com>
---
 Source/Windows/UnixLib/FEXUnixLib.cpp | 72 +++++++++++++++++++++++----
 1 file changed, 63 insertions(+), 9 deletions(-)

diff --git a/Source/Windows/UnixLib/FEXUnixLib.cpp b/Source/Windows/UnixLib/FEXUnixLib.cpp
index ade8222..3e9d7c1 100644
--- a/Source/Windows/UnixLib/FEXUnixLib.cpp
+++ b/Source/Windows/UnixLib/FEXUnixLib.cpp
@@ -4,7 +4,9 @@
 #include <fcntl.h>
 #include <string>
 #include <sys/mman.h>
+#ifndef __APPLE__
 #include <sys/prctl.h>
+#endif
 #include <unistd.h>
 
 #include "FEXUnixLib.h"
@@ -19,10 +21,11 @@ constexpr std::underlying_type_t<Enum> ToUnderlying(Enum e) noexcept {
 using NTSTATUS = int32_t;
 using unixlib_entry_t = NTSTATUS (*)(void*);
 
-constexpr NTSTATUS STATUS_SUCCESS = 0;
-constexpr NTSTATUS STATUS_NOT_SUPPORTED = 0xC00000BB;
-constexpr NTSTATUS STATUS_INTERNAL_ERROR = 0xC00000E5;
+[[maybe_unused]] constexpr NTSTATUS STATUS_SUCCESS = 0;
+[[maybe_unused]] constexpr NTSTATUS STATUS_NOT_SUPPORTED = 0xC00000BB;
+[[maybe_unused]] constexpr NTSTATUS STATUS_INTERNAL_ERROR = 0xC00000E5;
 
+#ifndef __APPLE__
 #ifndef PR_GET_MEM_MODEL
 #define PR_GET_MEM_MODEL 0x6d4d444c
 #endif
@@ -44,9 +47,17 @@ constexpr NTSTATUS STATUS_INTERNAL_ERROR = 0xC00000E5;
 #ifndef PR_SET_VMA_ANON_NAME
 #define PR_SET_VMA_ANON_NAME 0
 #endif
+#endif
 
-static NTSTATUS FEXUnixLib_SetHardwareTSOControlHandler(void* _Args) {
+static NTSTATUS FEXUnixLib_SetHardwareTSOControlHandler([[maybe_unused]] void* _Args) {
   auto Args = reinterpret_cast<const FEXUnixLib_SetHardwareTSOControlArgs*>(_Args);
+#ifdef __APPLE__
+  if (Args->Enable) {
+    return STATUS_NOT_SUPPORTED;
+  }
+
+  return STATUS_SUCCESS;
+#else
   if (Args->Enable) {
     int ret = prctl(PR_GET_MEM_MODEL, 0, 0, 0, 0);
     if (ret == PR_SET_MEM_MODEL_DEFAULT) {
@@ -57,25 +68,59 @@ static NTSTATUS FEXUnixLib_SetHardwareTSOControlHandler(void* _Args) {
 
   prctl(PR_SET_MEM_MODEL, PR_SET_MEM_MODEL_DEFAULT, 0, 0, 0);
   return STATUS_SUCCESS;
+#endif
 }
 
-static NTSTATUS FEXUnixLib_SetKernelUnalignedAtomicControlHandler(void* _Args) {
+static NTSTATUS FEXUnixLib_SetKernelUnalignedAtomicControlHandler([[maybe_unused]] void* _Args) {
+#ifdef __APPLE__
+  return STATUS_NOT_SUPPORTED;
+#else
   auto Args = reinterpret_cast<const FEXUnixLib_SetKernelUnalignedAtomicControl*>(_Args);
   return prctl(PR_ARM64_SET_UNALIGN_ATOMIC, Args->Flags, 0, 0, 0) == 0 ? STATUS_SUCCESS : STATUS_NOT_SUPPORTED;
+#endif
 }
 
-static NTSTATUS FEXUnixLib_MadviseHandler(void* _Args) {
+static NTSTATUS FEXUnixLib_MadviseHandler([[maybe_unused]] void* _Args) {
   auto Args = reinterpret_cast<const FEXUnixLib_Madvise*>(_Args);
+#ifdef __APPLE__
+  constexpr int LINUX_MADV_NORMAL = 0;
+  constexpr int LINUX_MADV_RANDOM = 1;
+  constexpr int LINUX_MADV_SEQUENTIAL = 2;
+  constexpr int LINUX_MADV_WILLNEED = 3;
+  constexpr int LINUX_MADV_DONTNEED = 4;
+  constexpr int LINUX_MADV_FREE = 8;
+
+  int Advise {};
+  switch (Args->Advise) {
+    case LINUX_MADV_NORMAL: Advise = MADV_NORMAL; break;
+    case LINUX_MADV_RANDOM: Advise = MADV_RANDOM; break;
+    case LINUX_MADV_SEQUENTIAL: Advise = MADV_SEQUENTIAL; break;
+    case LINUX_MADV_WILLNEED: Advise = MADV_WILLNEED; break;
+    case LINUX_MADV_DONTNEED: Advise = MADV_DONTNEED; break;
+    case LINUX_MADV_FREE: Advise = MADV_FREE; break;
+    default:
+      return STATUS_SUCCESS;
+  }
+
+  madvise(const_cast<void*>(Args->Addr), Args->Size, Advise);
+  return STATUS_SUCCESS;
+#else
   return madvise(const_cast<void*>(Args->Addr), Args->Size, Args->Advise) == 0 ? STATUS_SUCCESS : STATUS_INTERNAL_ERROR;
+#endif
 }
 
-static NTSTATUS FEXUnixLib_SetVMANameHandler(void* _Args) {
+static NTSTATUS FEXUnixLib_SetVMANameHandler([[maybe_unused]] void* _Args) {
+#ifdef __APPLE__
+  return STATUS_SUCCESS;
+#else
   auto Args = reinterpret_cast<const FEXUnixLib_SetVMAName*>(_Args);
   return prctl(PR_SET_VMA, PR_SET_VMA_ANON_NAME, reinterpret_cast<unsigned long>(Args->Addr), Args->Size, Args->Name) == 0 ?
            STATUS_SUCCESS :
            STATUS_INTERNAL_ERROR;
+#endif
 }
 
+#ifndef __APPLE__
 constexpr static int USER_PERMS = S_IRWXU | S_IRWXG | S_IRWXO;
 static inline void* InitializeSHM(uint32_t MapSize, uint32_t MaxSize) {
   void* Base {};
@@ -146,8 +191,12 @@ err:
   close(fd);
   return Result;
 }
+#endif
 
-static NTSTATUS FEXUnixLib_GetSHMStatsVMAHandler(void* _Args) {
+static NTSTATUS FEXUnixLib_GetSHMStatsVMAHandler([[maybe_unused]] void* _Args) {
+#ifdef __APPLE__
+  return STATUS_NOT_SUPPORTED;
+#else
   auto Args = reinterpret_cast<FEXUnixLib_GetSHMStatsVMA*>(_Args);
   if (Args->SHMBase == nullptr) {
     Args->SHMBase = InitializeSHM(Args->MapSize, Args->MaxSize);
@@ -155,12 +204,17 @@ static NTSTATUS FEXUnixLib_GetSHMStatsVMAHandler(void* _Args) {
   }
 
   return AllocateMoreSlots(Args->SHMBase, Args->MapSize) ? STATUS_SUCCESS : STATUS_INTERNAL_ERROR;
+#endif
 }
 
-static NTSTATUS FEXUnixLib_DeleteSHMStatsFileHandler(void* _Args) {
+static NTSTATUS FEXUnixLib_DeleteSHMStatsFileHandler([[maybe_unused]] void* _Args) {
+#ifdef __APPLE__
+  return STATUS_SUCCESS;
+#else
   const std::string Name = "fex-" + std::to_string(getpid()) + "-stats";
   shm_unlink(Name.c_str());
   return STATUS_SUCCESS;
+#endif
 }
 
 static NTSTATUS FEXUnixLib_MapFileHandler(void* _Args) {
