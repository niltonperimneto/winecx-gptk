    "Wine/lib/wine/x86_64-windows/d3d11on12host.dll",
    "Wine/lib/wine/x86_64-windows/dxilconv.dll",
    "DXVK/x64/d3d11.dll",
    "DXVK/x32/d3d11.dll",
    "DXVK/x32/dxgi.dll",
    "DXMT/x64",
    "DXMT/x32",
    "WhiskyWineVersion.plist",
    "RuntimeManifest.json"
  ],
  "kosmickrisp": [
    "Wine/bin/wine-kosmickrisp",
    "Wine/bin/wine-kosmickrisp-dxvk",
    "Wine/share/kosmickrisp/dxvk-prefix.py",
    "Wine/lib/kosmickrisp/libvulkan.1.dylib",
    "Wine/lib/kosmickrisp/libvulkan_kosmickrisp.dylib",
    "Wine/lib/kosmickrisp/kosmickrisp_icd.json",
    "DXVK3/x64/d3d11.dll",
    "DXVK3/x64/dxgi.dll",
    "DXVK3/x32/d3d11.dll",
    "DXVK3/x32/dxgi.dll"
  ]
