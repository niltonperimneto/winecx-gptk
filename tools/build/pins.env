# Pinned build inputs shared by CI and local scripts.
export WINECX_REPO=https://github.com/niltonperimneto/winecx.git
export WINECX_COMMIT=f70ef290f7e5dfc4462aed03f593229be737c59c
# Keep the x86_64-darwin package set pinned; newer nixpkgs drops this platform.
export NIXPKGS_REV=ac62194c3917d5f474c1a844b6fd6da2db95077d
export MOLTENVK_VERSION=1.4.2
export FAUDIO_VERSION=26.10
export DXVK_VERSION=1.10.3
# Upstream's 32-bit dxgi from the same release; the macOS repack has none.
export DXVK_UPSTREAM_SHA256=8d1a3c912761b450c879f98478ae64f6f6639e40ce6848170a0f6b8596fd53c6
# Immutable upstream CI payload mirrored as a persistent fork release.
export DXMT_REPO=niltonperimneto/dxmt
export DXMT_VERSION=main-186a232
export DXMT_COMMIT=186a2327f1ec76376f6bc1ef64636f08b0728567
export DXMT_RELEASE_TAG=v0.80-relay12.186a232
export DXMT_ARTIFACT=dxmt-186a2327-builtin.tar.gz
export DXMT_ARTIFACT_SHA256=2126e74a30c7d4d415d63509de955d33c8e6f30df418763ccd09a58320382623
# Relay12 modules are verified against the source-pinned release archive.
export RELAY12_REPO=niltonperimneto/relay12
export RELAY12_COMMIT=fd35bce752b5a96e950227cc1bc9edfc563ea1a1
export RELAY12_RELEASE_TAG=runtime-fd35bce
export RELAY12_ARTIFACT_SHA256=8de0add5f05f6104cbd148fd6e27f00356b90bbb79f2d612434eea22e0b1aa82
# Enforce the runtime floor regardless of the builder's installed SDK.
export MACOSX_DEPLOYMENT_TARGET=26.0
