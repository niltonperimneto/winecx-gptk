export RELAY12_COMMIT=524cd47050f166abf012b827696df3bde1bb74d3
export RELAY12_RELEASE_TAG=runtime-524cd47
export RELAY12_ARTIFACT_SHA256=a82683a0046c8c5e857261ebe5a449e8fc1afab6ee3918f45b1f470d650cc60c
