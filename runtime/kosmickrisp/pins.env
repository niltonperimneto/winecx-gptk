# KosmicKrisp cross-build recipe and the complete Mesa fork built by default.
# build.sh freezes the pinned fork commit instead of the recipe's old submodule.
KOSMICKRISP_BUILD_COMMIT=af7dd0a35c071cecbfff32662675641d19e8e4db
KOSMICKRISP_MESA_REPO=https://github.com/niltonperimneto/mesa.git
KOSMICKRISP_MESA_COMMIT=48af13fa84e169c197c8034cf5c645bcf308f4a6
VULKAN_LOADER_COMMIT=32fcb949e253cbeb40cda7ea76122b492db579ae
VULKAN_HEADERS_COMMIT=b5c8f996196ba4aa6d8f97e52b5d3b6e70f7e4e2
# Keep DXVK in the payload cache, independently of Mesa/loader revisions.
source "$(dirname "${BASH_SOURCE[0]}")/../../tools/build/pins.env"
