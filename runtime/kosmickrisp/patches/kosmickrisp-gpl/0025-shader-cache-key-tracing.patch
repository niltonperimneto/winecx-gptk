+static void
+kk_cache_namespace(struct vk_physical_device *physical, char out[33])
+{
+   static const char hex[] = "0123456789abcdef";
+   for (unsigned i = 0; i < VK_UUID_SIZE; ++i) {
+      uint8_t value = physical->properties.pipelineCacheUUID[i];
+      out[i * 2] = hex[value >> 4];
