+           "\"family_id\":\"%s\",\"origin\":\"%s\","
+           "\"thread_id\":%llu,\"start_ns\":%lld,\"end_ns\":%lld}\n",
+           kk_variant_names[phase], id, parent, family, origins[kk_compile_origin],
+           (unsigned long long)thread_id, (long long)start, (long long)end);
