+static bool
+kk_history_matches(const struct kk_prewarm_job *job, const struct kk_variant_recipe *r)
+{
+   const struct kk_variant_recipe *d = &job->recipe;
+   if (memcmp(r->fs.rt_formats, d->fs.rt_formats, sizeof(r->fs.rt_formats)) ||
+       r->fs.remove_depth != d->fs.remove_depth || r->pso.amplification != d->pso.amplification ||
+       r->pso.topology_class != d->pso.topology_class)
+      return false;
+   if ((!BITSET_TEST(job->dynamic, MESA_VK_DYNAMIC_MS_RASTERIZATION_SAMPLES) &&
+        r->pso.sample_count != d->pso.sample_count) ||
+       (!BITSET_TEST(job->dynamic, MESA_VK_DYNAMIC_MS_SAMPLE_MASK) && r->sample_mask != d->sample_mask) ||
+       (!BITSET_TEST(job->dynamic, MESA_VK_DYNAMIC_MS_ALPHA_TO_COVERAGE_ENABLE) &&
+        (r->pso.alpha_to_coverage || r->fs.alpha_to_coverage) !=
+        (d->pso.alpha_to_coverage || d->fs.alpha_to_coverage)) ||
+       (!BITSET_TEST(job->dynamic, MESA_VK_DYNAMIC_MS_ALPHA_TO_ONE_ENABLE) &&
+        (r->pso.alpha_to_one || r->fs.alpha_to_one) != (d->pso.alpha_to_one || d->fs.alpha_to_one)) ||
+       (!BITSET_TEST(job->dynamic, MESA_VK_DYNAMIC_CB_LOGIC_OP_ENABLE) && r->logic_enable != d->logic_enable) ||
+       (!BITSET_TEST(job->dynamic, MESA_VK_DYNAMIC_CB_LOGIC_OP) && r->logic_op != d->logic_op) ||
+       (!BITSET_TEST(job->dynamic, MESA_VK_DYNAMIC_CB_COLOR_WRITE_ENABLES) && r->write_enables != d->write_enables))
+      return false;
+   for (unsigned i = 0; i < MAX_DRAW_BUFFERS; ++i) {
+      const struct vk_color_blend_attachment_state *a = &r->input_blend[i];
+      const struct vk_color_blend_attachment_state *b = &d->input_blend[i];
+      if ((!BITSET_TEST(job->dynamic, MESA_VK_DYNAMIC_CB_BLEND_ENABLES) && a->blend_enable != b->blend_enable) ||
+          (!BITSET_TEST(job->dynamic, MESA_VK_DYNAMIC_CB_WRITE_MASKS) && a->write_mask != b->write_mask))
+         return false;
+      if (!BITSET_TEST(job->dynamic, MESA_VK_DYNAMIC_CB_BLEND_EQUATIONS) &&
+          (a->src_color_blend_factor != b->src_color_blend_factor ||
+           a->dst_color_blend_factor != b->dst_color_blend_factor ||
+           a->src_alpha_blend_factor != b->src_alpha_blend_factor ||
+           a->dst_alpha_blend_factor != b->dst_alpha_blend_factor ||
+           a->color_blend_op != b->color_blend_op || a->alpha_blend_op != b->alpha_blend_op))
+         return false;
+      if (!BITSET_TEST(job->dynamic, MESA_VK_DYNAMIC_CB_BLEND_ADVANCED) &&
+          (a->src_premultiplied != b->src_premultiplied || a->dst_premultiplied != b->dst_premultiplied ||
+           a->blend_overlap != b->blend_overlap || a->clamp_results != b->clamp_results))
+         return false;
+   }
+   return true;
+}
