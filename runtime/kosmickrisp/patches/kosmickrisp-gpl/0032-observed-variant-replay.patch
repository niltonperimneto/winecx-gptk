+      if (trace_enabled) {
+         memcpy(kk_variant_parent_id, previous, sizeof(previous));
+         kk_variant_parent_valid = previous_valid;
+         memcpy(kk_variant_family_id, previous_family, sizeof(previous_family));
+         kk_variant_family_valid = previous_family_valid;
+      }
+      return NULL;
+   }
+   bool first = entry && kk_compile_origin == KK_COMPILE_ORIGIN_DRAW && !entry->drawn;
+   if (first) {
+      entry->drawn = true;
+      kk_variant_trace(dev, KK_VARIANT_FIRST_DEMAND, recipe, sizeof(*recipe), 0, 0);
+   }
+   if (entry && kk_compile_origin == KK_COMPILE_ORIGIN_DRAW &&
+       (entry->compiling || entry->queued)) {
+      int64_t start = os_time_get_nano();
+      while (entry->compiling || entry->queued)
+         cnd_wait(&entry->ready, &cache->lock);
