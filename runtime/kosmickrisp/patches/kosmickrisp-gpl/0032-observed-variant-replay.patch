+      free(job);
+      return;
+   }
+   if (cache->pending_jobs >= 64 || (exact && cache->exact_jobs >= 16) ||
+       (needs_history && cache->family_count >= cache->recipe_limit)) {
+      cache->limited = true;
+      mtx_unlock(&cache->lock);
+      free(job);
+      return;
+   }
+   struct kk_recipe_entry *entry = he ? he->data : kk_recipe_insert_locked(cache, &job->recipe);
+   if (!entry) {
