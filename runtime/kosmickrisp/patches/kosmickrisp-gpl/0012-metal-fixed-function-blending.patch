+void
+mtl_render_pipeline_descriptor_set_color_attachment_blend(mtl_render_pipeline_descriptor *descriptor,
+                                                          uint8_t index, bool enable,
+                                                          enum mtl_blend_factor src_rgb,
+                                                          enum mtl_blend_factor dst_rgb,
+                                                          enum mtl_blend_operation op_rgb,
+                                                          enum mtl_blend_factor src_alpha,
+                                                          enum mtl_blend_factor dst_alpha,
+                                                          enum mtl_blend_operation op_alpha,
+                                                          uint8_t write_mask)
+{
+   @autoreleasepool {
+      MTL4RenderPipelineDescriptor *desc = (MTL4RenderPipelineDescriptor *)descriptor;
+      MTL4RenderPipelineColorAttachmentDescriptor *att = desc.colorAttachments[index];
+      att.blendingState = enable ? MTL4BlendStateEnabled : MTL4BlendStateDisabled;
+      att.sourceRGBBlendFactor = (MTLBlendFactor)src_rgb;
+      att.destinationRGBBlendFactor = (MTLBlendFactor)dst_rgb;
+      att.rgbBlendOperation = (MTLBlendOperation)op_rgb;
+      att.sourceAlphaBlendFactor = (MTLBlendFactor)src_alpha;
+      att.destinationAlphaBlendFactor = (MTLBlendFactor)dst_alpha;
+      att.alphaBlendOperation = (MTLBlendOperation)op_alpha;
+      att.writeMask = (MTLColorWriteMask)write_mask;
+   }
+}
