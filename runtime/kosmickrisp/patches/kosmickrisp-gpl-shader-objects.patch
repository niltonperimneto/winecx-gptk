+               vk_shader_destroy(device, shaders_out[j], pAllocator);
+            for (uint32_t j = i + 1u; j < shader_count; ++j)
+               ralloc_free(infos[j].nir);
+            memset(shaders_out, 0, shader_count * sizeof(*shaders_out));
+            return result;
+         }
