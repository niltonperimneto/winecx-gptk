+   draw.grid = kk_grid_indirect(data.indirect_command.addr);
+   draw.index.gpu = data.index_buffer;
+   draw.index.el_size_B = data.index_buffer_el_size_B;
+   draw.primitive_type = mesa_prim_to_mtl_primitive_type(data.prim);
