+vk_color_write_mask_to_mtl_color_write_mask(uint8_t mask)
+{
+   uint8_t mtl_mask = MTL_COLOR_WRITE_MASK_NONE;
+   if (mask & VK_COLOR_COMPONENT_R_BIT)
+      mtl_mask |= MTL_COLOR_WRITE_MASK_RED;
+   if (mask & VK_COLOR_COMPONENT_G_BIT)
