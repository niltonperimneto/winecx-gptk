+   if (enabled_features == NULL)
+      enabled_features = &device->enabled_features;
+   enum kk_feature_key features = kk_make_feature_key(enabled_features);
+
+   if (state == NULL && infos[0].stage != MESA_SHADER_COMPUTE) {
