#!/bin/bash
# Legacy native-ARM64 research launcher; not installed in layout-v2 runtimes.
# Requires a matching ARM64 loader/driver. Older WineCX needs the wined3d
# selector to honor CX_LIBVULKAN; this preserves that legacy launch contract.
set -euo pipefail
wine_bin=$(cd -- "$(dirname -- "$0")" && pwd -P)
bundle="$wine_bin/../lib/kosmickrisp"
for required in libvulkan.1.dylib libvulkan_kosmickrisp.dylib kosmickrisp_icd.json; do
    [ -f "$bundle/$required" ] || { echo "Missing KosmicKrisp component: $required" >&2; exit 1; }
done
export CX_LIBVULKAN="$bundle/libvulkan.1.dylib"
export CX_ACTIVE_GRAPHICS_BACKEND=wined3d
export VK_DRIVER_FILES="$bundle/kosmickrisp_icd.json"
# Inherited driver selection would override the bundled ICD.
unset VK_ICD_FILENAMES VK_ADD_DRIVER_FILES VK_LOADER_DRIVERS_SELECT VK_LOADER_DRIVERS_DISABLE
# Force the native Unix loader even if this shell was launched under Rosetta.
unset WINE_VULKAN_LIBRARY
exec /usr/bin/arch -arm64 "$wine_bin/wine" "$@"
