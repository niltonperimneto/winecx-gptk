#!/bin/bash
# Opt-in upstream DXVK + KosmicKrisp for a specific Wine prefix.
set -euo pipefail
wine_bin=$(cd -- "$(dirname -- "$0")" && pwd -P)
wine_root=$(cd -- "$wine_bin/../.." && pwd -P)
bundle="$wine_bin/../lib/kosmickrisp"
payload="$wine_root/DXVK3"
helper="$wine_bin/../share/kosmickrisp/dxvk-prefix.py"
prefix=${WINEPREFIX:?Set WINEPREFIX to the selected, initialized Wine bottle}
for required in "$bundle/libvulkan.1.dylib" "$bundle/libvulkan_kosmickrisp.dylib" \
                "$bundle/kosmickrisp_icd.json" "$payload/x64/d3d11.dll" \
                "$payload/x32/d3d11.dll" "$helper"; do
    [ -f "$required" ] || { echo "Missing KosmicKrisp/DXVK component: $required" >&2; exit 1; }
done
case "${1:-}" in
    --install-prefix|--restore-prefix)
        operation=${1#--}
        operation=${operation%-prefix}
        exec /usr/bin/python3 "$helper" "$operation" "$prefix" "$payload"
        ;;
esac
[ -f "$prefix/.winecx-kosmickrisp-dxvk.json" ] || {
    echo "Install DXVK first: WINEPREFIX=... $0 --install-prefix" >&2
    exit 1
}
export CX_LIBVULKAN="$bundle/libvulkan.1.dylib"
export CX_ACTIVE_GRAPHICS_BACKEND=wined3d
export VK_DRIVER_FILES="$bundle/kosmickrisp_icd.json"
export WINEDLLOVERRIDES="d3d8,d3d9,d3d10core,d3d11,dxgi=n;${WINEDLLOVERRIDES:-}"
unset WINE_VULKAN_LIBRARY VK_ICD_FILENAMES VK_ADD_DRIVER_FILES VK_LOADER_DRIVERS_SELECT VK_LOADER_DRIVERS_DISABLE
exec "$wine_bin/wine64" "$@"
